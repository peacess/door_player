{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "door_player",
            "cargo": {
                "args": [
                    "build",
                    "--bin=door_player",
                    "--package=door_player"
                ],
                "filter": {
                    "name": "door_player",
                    "kind": "bin"
                }
            },
            "cwd": "${workspaceFolder}",
            "linux": {
                "env": {
                //   "LD_LIBRARY_PATH": "${workspaceFolder}/"
                }
            },
            "windows": {
                "env": {
                    "PATH": "${workspaceFolder}/vcpkg_installed/x64-windows/bin"
                }
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "tests door_player",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=door_player",
                    "--package=door_player"
                ],
                "filter": {
                    "name": "door_player",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "windows": {
                "env": {
                    "PATH": "${workspaceFolder}/vcpkg_installed/x64-windows/bin"
                }
            }
        }
    ]
}
