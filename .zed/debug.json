  {
    "label": "door_player window",
    "adapter": "CodeLLDB",
    "build":{
      "command": "cargo",
      "args": ["build"],
      "env": {
     			"PKG_CONFIG_PATH":"$ZED_WORKTREE_ROOT/vcpkg_installed/x64-windows/lib/pkgconfig",
